{
  "name": "dsh-deepseek-billing",
  "version": "0.2.0",
  "description": "DeepSeek account balance viewer and slash command for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.5-rc.2 <0.1.6",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.1.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golitter/dsh-deepseek-billing.git"
  },
  "homepage": "https://github.com/golitter/dsh-deepseek-billing#readme",
  "bugs": {
    "url": "https://github.com/golitter/dsh-deepseek-billing/issues"
  }
}
